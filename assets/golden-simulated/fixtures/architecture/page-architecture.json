{
  "version": 1,
  "nodes": [
    {
      "id": "submission",
      "title": "Submission workspace",
      "parentId": "root",
      "modules": [
        {
          "id": "submission-actions",
          "name": "功能列表",
          "children": [
            {
              "id": "submit-submission",
              "name": "Create submission",
              "submissionScopeId": "submission-scope",
              "submissionRole": "primary-submit",
              "controlId": "submit-button",
              "outputSchema": {
                "type": "object",
                "required": ["submissionId", "status", "items"],
                "properties": {
                  "submissionId": { "type": "string", "minLength": 1 },
                  "status": { "type": "string", "enum": ["succeeded"] },
                  "items": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
                },
                "additionalProperties": false
              },
              "resultPresentation": { "targetRegion": "result-panel" },
              "aggregateSubmission": {
                "evidenceStatus": "documented",
                "operation": { "method": "POST", "path": "/api/submissions" },
                "finalProduct": {
                  "type": "submission-items",
                  "quantity": { "sourceField": "quantity-input" },
                  "lifecycle": ["processing", "available", "failed"],
                  "downstreamUsage": ["result presentation", "history"]
                }
              }
            },
            { "id": "upload-resource", "name": "Upload source file" },
            { "id": "planned-export", "name": "External submission review" }
          ]
        },
        {
          "id": "identity-section",
          "name": "Identity section",
          "submissionScopeId": "submission-scope",
          "submissionRole": "input-section",
          "regionId": "identity-section",
          "fieldIds": ["title-input"],
          "children": [{ "id": "title-field", "name": "Submission title", "controlId": "title-input" }]
        },
        {
          "id": "options-section",
          "name": "Options section",
          "submissionScopeId": "submission-scope",
          "submissionRole": "input-section",
          "regionId": "options-section",
          "fieldIds": ["category-select", "quantity-input"],
          "children": [
            { "id": "category-field", "name": "Submission category", "controlId": "category-select" },
            { "id": "quantity-field", "name": "Result quantity", "controlId": "quantity-input" }
          ]
        }
      ]
    }
  ]
}
